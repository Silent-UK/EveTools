# Required: replace these values before starting EveTools.
BASE_URL=https://tools.example.com
PORT=3014
DATA_DIR=/var/lib/evetools
EVE_CLIENT_ID=
EVE_CLIENT_SECRET=
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep this key for the lifetime of the database. Back it up separately.
ENCRYPTION_KEY=
OWNER_CHARACTER_ID=
CORPORATION_ID=
CORPORATION_NAME=
CORPORATION_TICKER=
SITE_NAME=EveTools
ALLIANCE_TICKER=
# Your support email or public project/contact URL, used in API identification.
ESI_CONTACT=
